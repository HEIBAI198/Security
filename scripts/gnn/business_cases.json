    "ecosystem": "npm",
    "min_graph_packages": 50,
    "must_not_be_malicious": [
      "axios",
      "typescript",
      "lodash",
      "@babel/core",
      "vite",
      "eslint",
      "prettier"
    ],
    "must_be_malicious": [
